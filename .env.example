# Copy to .env.local for local development. Keep .env.local untracked.
APP_TIMEZONE=UTC
KIOS_DB_HOST=127.0.0.1
KIOS_DB_PORT=33081
KIOS_DB_NAME=kios_development
KIOS_DB_USER=
KIOS_DB_PASSWORD=
KIOS_DB_MIGRATION_HOST=127.0.0.1
KIOS_DB_MIGRATION_PORT=33081
KIOS_DB_MIGRATION_NAME=kios_development
KIOS_DB_MIGRATION_USER=
KIOS_DB_MIGRATION_PASSWORD=
KIOS_CASHIER_PASSWORD=
KIOS_GROUND_FLOOR_PASSWORD=
KIOS_FIRST_FLOOR_KITCHEN_PASSWORD=
KIOS_MENU_ADMIN_PASSWORD_HASH=
PRINT_GATEWAY_ENABLED=0

# Account authentication cutover requires migration 011 and explicit release approval.
KIOS_ACCOUNT_AUTH_ENABLED=0
# Provision a private random value of at least 32 characters before enabling accounts.
KIOS_AUTH_RATE_KEY=

# Publication defaults: all public/financial/hardware integrations disabled
APP_ENV=local
KIOS_PUBLIC_REGISTRATION_ENABLED=0
KIOS_PUBLIC_ORDERING_ENABLED=0
KIOS_PAYMENTS_ENABLED=0
KIOS_PHYSICAL_PRINTING_ENABLED=0
KIOS_MERCHANT_CLOUD_ENABLED=0
KIOS_INTEGRATED_SETUP_ENABLED=0

# Private read-only API remains default-off
KIOS_PRIVATE_API_ENABLED=0

# Private discovery defaults off; no visible scopes by default
KIOS_PRIVATE_DISCOVERY_ENABLED=0
KIOS_PRIVATE_DISCOVERY_SCOPES=[]

# Internal synthetic customer identity remains off; no public customer authentication
KIOS_CUSTOMER_IDENTITY_ENABLED=0

# Internal synthetic order-intent simulation, no public order endpoint
KIOS_CUSTOMER_ORDER_INTENTS_ENABLED=0

# Internal synthetic partner foundation; no public delivery activation
KIOS_DELIVERY_IDENTITY_ENABLED=0
KIOS_DELIVERY_REGISTRATION_ENABLED=0
KIOS_DELIVERY_DISPATCH_ENABLED=0
KIOS_DELIVERY_GPS_ENABLED=0
