Options -Indexes
DirectoryIndex index.php demo.php

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

ErrorDocument 500 /500.html

<IfModule mod_headers.c>
    <FilesMatch "\.webp$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
